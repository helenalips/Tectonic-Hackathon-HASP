# Copy to .env and fill in. .env is git-ignored. Never commit real values.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Shared password for the fictional, local-only demo users (documented in README). Min. 12 chars.
DEMO_PASSWORD=TrustGrid-Demo-2026
# mock = deterministic rules, no API key needed. claude = Anthropic API.
LLM_MODE=mock
ANTHROPIC_API_KEY=
# Set true only when served over HTTPS
COOKIE_SECURE=false
