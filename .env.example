# Copy to .env and fill in. .env is git-ignored. Never commit real values.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Password for all seeded demo users (min. 12 chars)
DEMO_PASSWORD=
# mock = deterministic rules, no API key needed. claude = Anthropic API.
LLM_MODE=mock
ANTHROPIC_API_KEY=
# Set true only when served over HTTPS
COOKIE_SECURE=false
